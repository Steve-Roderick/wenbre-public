{
  "name": "wenbre",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Ten days, ten friends, one shared game night.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler pages dev public",
    "build": "node scripts/validate.mjs",
    "test": "node --experimental-sqlite --experimental-vm-modules --test --experimental-test-isolation=none tests/*.test.js",
    "check": "npm run build && npm test",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:production": "wrangler d1 migrations apply DB --remote",
    "room:provision": "node scripts/provision-room.mjs",
    "room:rotate": "node scripts/rotate-room-secret.mjs",
    "room:list": "node scripts/list-rooms.mjs",
    "room:cleanup": "node scripts/cleanup.mjs",
    "check:functions": "wrangler pages functions build --outdir .wrangler/functions-build",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "wrangler": "4.151.1"
  },
  "imports": {
    "#rooms": {
      "node": "./config/rooms-node.js",
      "default": "./config/rooms.json"
    }
  }
}
